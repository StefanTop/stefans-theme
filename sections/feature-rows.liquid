{{ 'section-feature-rows.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="feature-rows page-width isolate section-{{ section.id }}-padding">
    {%- for block in section.blocks -%}
      <div
        class="feature-rows__row{% if block.settings.image_position == 'right' %} feature-rows__row--reverse{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div class="feature-rows__media">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="feature-rows__content">
          {%- if block.settings.title != blank or block.settings.title_accent != blank -%}
            <h3 class="feature-rows__title">
              {{- block.settings.title -}}
              {%- if block.settings.title_accent != blank -%}
                <span class="feature-rows__title-accent"> {{ block.settings.title_accent }}</span>
              {%- endif -%}
            </h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="feature-rows__text rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.feature-rows.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.feature-rows.blocks.row.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.feature-rows.blocks.row.settings.image.label"
        },
        {
          "type": "select",
          "id": "image_position",
          "options": [
            {
              "value": "left",
              "label": "t:sections.feature-rows.blocks.row.settings.image_position.options__1.label"
            },
            {
              "value": "right",
              "label": "t:sections.feature-rows.blocks.row.settings.image_position.options__2.label"
            }
          ],
          "default": "left",
          "label": "t:sections.feature-rows.blocks.row.settings.image_position.label"
        },
        {
          "type": "text",
          "id": "title",
          "default": "t:sections.feature-rows.blocks.row.settings.title.default",
          "label": "t:sections.feature-rows.blocks.row.settings.title.label"
        },
        {
          "type": "text",
          "id": "title_accent",
          "default": "t:sections.feature-rows.blocks.row.settings.title_accent.default",
          "label": "t:sections.feature-rows.blocks.row.settings.title_accent.label",
          "info": "t:sections.feature-rows.blocks.row.settings.title_accent.info"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.feature-rows.blocks.row.settings.text.default",
          "label": "t:sections.feature-rows.blocks.row.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.feature-rows.presets.name",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
