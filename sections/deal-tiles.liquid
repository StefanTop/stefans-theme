{{ 'section-deal-tiles.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="deal-tiles page-width isolate section-{{ section.id }}-padding">
    {%- if section.blocks.size > 0 -%}
      <div class="deal-tiles__grid">
        {%- for block in section.blocks -%}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="deal-tiles__tile"
            style="background: {{ block.settings.background_color }};"
            {{ block.shopify_attributes }}
          >
            <span class="deal-tiles__tag" style="color: {{ block.settings.tag_color }};">
              {{- block.settings.tag -}}
              <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
            </span>
            <span class="deal-tiles__title">{{ block.settings.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.deal-tiles.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:sections.deal-tiles.blocks.tile.name",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "default": "t:sections.deal-tiles.blocks.tile.settings.tag.default",
          "label": "t:sections.deal-tiles.blocks.tile.settings.tag.label"
        },
        {
          "type": "text",
          "id": "title",
          "default": "t:sections.deal-tiles.blocks.tile.settings.title.default",
          "label": "t:sections.deal-tiles.blocks.tile.settings.title.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.deal-tiles.blocks.tile.settings.link.label"
        },
        {
          "type": "color",
          "id": "background_color",
          "default": "#EFF4FE",
          "label": "t:sections.deal-tiles.blocks.tile.settings.background_color.label"
        },
        {
          "type": "color",
          "id": "tag_color",
          "default": "#2F7FF0",
          "label": "t:sections.deal-tiles.blocks.tile.settings.tag_color.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.deal-tiles.presets.name",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
