{% comment %}
  Renders a free shipping progress bar based on settings.free_shipping_threshold.

  Usage:
  {% render 'free-shipping-bar' %}
{% endcomment %}

{%- if settings.show_free_shipping_bar and settings.free_shipping_threshold > 0 -%}
  {%- liquid
    assign threshold_cents = settings.free_shipping_threshold | times: 100
    assign remaining_cents = threshold_cents | minus: cart.total_price
    if remaining_cents < 0
      assign remaining_cents = 0
    endif
    assign progress = cart.total_price | times: 100.0 | divided_by: threshold_cents
    if progress > 100
      assign progress = 100
    endif
    assign remaining_money = remaining_cents | money
  -%}
  <div class="free-shipping-bar" {% if cart == empty %}hidden{% endif %}>
    <p class="free-shipping-bar__message caption">
      {%- if remaining_cents <= 0 -%}
        {{ 'sections.cart.free_shipping_bar.qualified_html' | t }}
      {%- else -%}
        {{ 'sections.cart.free_shipping_bar.remaining_html' | t: amount: remaining_money }}
      {%- endif -%}
    </p>
    <div
      class="free-shipping-bar__track"
      role="progressbar"
      aria-valuenow="{{ progress }}"
      aria-valuemin="0"
      aria-valuemax="100"
    >
      <div class="free-shipping-bar__fill{% if remaining_cents <= 0 %} free-shipping-bar__fill--complete{% endif %}" style="width: {{ progress }}%"></div>
    </div>
  </div>
{%- endif -%}
