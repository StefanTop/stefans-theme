{% comment %}
  Renders a simple breadcrumb trail for the product page: Home / Collection / Product title

  Usage:
  {% render 'product-breadcrumb' %}
{% endcomment %}

{%- liquid
  assign breadcrumb_collection = product.collections.first
  if collection != blank
    assign breadcrumb_collection = collection
  endif
-%}

<nav class="product__breadcrumb caption" aria-label="{{ 'general.breadcrumb.label' | t }}">
  <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
  <span aria-hidden="true">/</span>
  {%- if breadcrumb_collection != blank -%}
    <a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title }}</a>
  {%- else -%}
    <a href="{{ routes.all_products_collection_url }}">{{ 'general.breadcrumb.all_products' | t }}</a>
  {%- endif -%}
  <span aria-hidden="true">/</span>
  <span aria-current="page">{{ product.title }}</span>
</nav>
